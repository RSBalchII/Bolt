{
  "name": "bolt",
  "version": "1.0.0",
  "description": "Bolt - AI Orchestrator for Termux with Anchor Engine memory",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --expose-gc --max-old-space-size=4096 node_modules/@rbalchii/anchor-engine/engine/dist/index.js start",
    "start:mcp": "node node_modules/@rbalchii/anchor-engine/mcp-server/dist/index.js",
    "install:engine": "npm install @rbalchii/anchor-engine --ignore-scripts",
    "postinstall": "cd node_modules/@rbalchii/anchor-engine/engine && npm run build"
  },
  "keywords": [
    "ai-orchestrator",
    "llm",
    "memory",
    "anchor-engine",
    "termux",
    "qwen-code"
  ],
  "author": "Robert Balch II",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@rbalchii/anchor-engine": "^4.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RSBalchII/bolt.git"
  }
}