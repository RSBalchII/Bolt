engine/context_data/
engine/context/
backups/
logs/
*.log
engine-startup.log
engine-startup-*.log

# Sensitive Configuration
user_settings.json
user_settings.*.json
sovereign.yaml
.env
.env.*
*.env
orchestrator-config.json

# Build Outputs
dist/
engine/dist/
engine/dist-android/
engine/dist-win/
node_modules/
packages/*/node_modules/
integrations/*/dist/
mcp-server/dist/

# Temporary Files
tmp/
temp/
*.tmp
*.temp
.cache/
.qwen/

# Test Artifacts
coverage/
test-results/
*.test.log
test-github-ingest-*/
test-physics-db-*/

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Generated Documentation
QWEN.md

